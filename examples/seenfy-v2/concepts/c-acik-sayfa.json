{
 "version": 2,
 "app": "Seenfy",
 "evidence": "../evidence.json",
 "lang": "tr",
 "sizes": [
  "ios",
  "ios-large",
  "android"
 ],
 "promise_words": [
  "izle",
  "film",
  "dizi"
 ],
 "concept": {
  "name": "Açık Sayfa",
  "idea": "Karanlık bir film uygulaması açık bir sayfada: zemin uygulamanın kendi yazı rengi (#EAF6F6), başlıklar onun siyahıyla. Koyu ekranlar ve kartlar kâğıt üstündeki nesneler gibi durur. Uygulamanın ilerleme çubuğu setin altında ince bir indigo çizgi olarak akar ve her görselde biraz daha ilerler: set de bir izleme gibi."
 },
 "campaign": {
  "tokens": {
   "paper": "#EAF6F6",
   "rule": "#D2E4EA",
   "ink": "#121212",
   "muted": "#5B6168",
   "accent": "#5460F0",
   "frame": "#121212"
  },
  "fonts": {
   "display": "../fonts/Poppins_600SemiBold.ttf",
   "text": "../fonts/Poppins_400Regular.ttf"
  },
  "type": {
   "headline": {
    "font": "display",
    "size": 0.096,
    "min_size": 0.072,
    "line_height": 1.1,
    "tracking": -0.022,
    "color": "$ink",
    "max_lines": 3,
    "emphasis": {
     "style": "color",
     "color": "$accent"
    }
   },
   "sub": {
    "font": "text",
    "size": 0.037,
    "line_height": 1.35,
    "tracking": 0,
    "color": "$muted"
   }
  }
 },
 "shots": [
  {
