     "x": 0.08,
     "y": 0.14,
     "w": 0.86
    },
    {
     "type": "text",
     "role": "sub",
     "style": "sub",
     "text": "Son izlediklerine göre senin için seçilir.",
     "x": 0.08,
     "below": "head",
     "gap": 0.03,
     "w": 0.8
    },
    {
